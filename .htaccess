# Aweron — настройки для хостинга на Apache (Beget, Timeweb и т. п.).
# На GitHub Pages и других хостингах без Apache этот файл игнорируется.

AddDefaultCharset utf-8
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

# --- HTTPS ---
# Включите ПОСЛЕ того, как на хостинге выпущен SSL-сертификат и сайт открывается по https://
# Иначе сайт перестанет открываться.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteCond %{HTTP:X-Forwarded-Proto} !https
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# --- Заголовки безопасности ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # После включения HTTPS:
  # Header always set Strict-Transport-Security "max-age=31536000"

  # Политика безопасности контента (CSP). Перед включением замените n8n.example.ru на домен вашего вебхука,
  # иначе форма перестанет отправляться. Проверьте в консоли браузера, что нет ошибок CSP.
  # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://mc.yandex.ru https://yastatic.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://mc.yandex.ru https://mc.yandex.com; connect-src 'self' https://n8n.example.ru https://mc.yandex.ru https://mc.yandex.com; frame-src https://mc.yandex.ru https://mc.yandex.com; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# --- Сжатие ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Кэширование ---
# CSS и JS без хэша в имени — кэшируем на сутки, чтобы правки доходили до посетителей быстро.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
